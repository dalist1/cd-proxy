# Defaults shown for cd-proxy
CD_PROXY_HOST=127.0.0.1
CD_PROXY_PORT=8318
CD_PROXY_AUTH_DIR=~/.local/share/cd-proxy/auths
CD_PROXY_API_KEY_FILE=~/.config/cd-proxy/api-key
CD_PROXY_UPSTREAM_BASE=https://chatgpt.com/backend-api/codex
# CD_PROXY_AUTH_TOKEN_URL=https://auth.openai.com/oauth/token
# CD_PROXY_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
CD_PROXY_MAX_RETRY_CREDENTIALS=5
CD_PROXY_COOLDOWN_MS=30000
CD_PROXY_CACHE_AFFINITY=1
CD_PROXY_CACHE_AFFINITY_HEADERS=session_id,x-session-affinity
CD_PROXY_CACHE_AFFINITY_BODY_FIELDS=prompt_cache_key,session_id
# CD_PROXY_DEBUG=1
# CD_PROXY_DEBUG_SAVE_REQUESTS=1
# CD_PROXY_DEBUG_SAVE_DIR=~/.local/share/cd-proxy/debug-requests
# CD_PROXY_DEBUG_SAVE_BODY_BYTES=1048576
# CD_PROXY_DEBUG_SAVE_MAX_PENDING=1024
# CD_PROXY_MODELS=gpt-5.3-codex,gpt-5.3-codex-spark,codex-auto-review
